{
  "$schema": "node_modules/wrangler/config-schema.json",
  // MUST match the Worker's real name in the Cloudflare account — the one the
  // dashboard-connected build (Workers Builds) deploys to and the one
  // www.dancehyderabad.com is routed to. A mismatch is not cosmetic: Workers
  // Builds silently substitutes its own name for the *script*, but NOT for
  // service-binding targets (see WORKER_SELF_REFERENCE below), so the deploy
  // fails with "references Worker '<old name>' which was not found"; and a
  // local `npm run deploy` would happily CREATE a worker under the stale name
  // and publish to it, serving nothing while reporting success.
  "name": "dancehyderabad",
  "main": ".open-next/worker.js",
  // `main` is generated by `opennextjs-cloudflare build`, never committed, and
  // plain `next build` does not emit it. This makes the Worker buildable from a
  // bare checkout whatever invoked wrangler — notably Cloudflare Workers
  // Builds, whose `wrangler versions upload` does not delegate to the OpenNext
  // CLI the way `wrangler deploy` does. The script no-ops when the entry point
  // is already built, so the paths that build first aren't slowed down; see
  // scripts/build-worker.mjs for the full rationale.
  "build": {
    "command": "node scripts/build-worker.mjs"
  },
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Only www.dancehyderabad.com may be crawlable — the *.workers.dev and
  // preview copies would be duplicate hosts competing with the real domain.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // OpenNext scaffolding: the Worker pointed at itself. Only read by the
  // durable-object queue / memory-queue overrides, neither of which this
  // project configures (open-next.config.ts sets incrementalCache only), so it
  // is inert here — but `service` must still name an EXISTING worker or the
  // upload is rejected outright. Keep it equal to "name" above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dancehyderabad"
    }
  ],
  // One physical bucket serves both bindings: OpenNext's incremental cache
  // writes under its own key prefix, app content lives at the root.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "furor-content"
    },
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "furor-content"
    }
  ],
  // Secrets (set via `wrangler secret put <NAME>` — never in this file):
  //   JWT_SECRET, ADMIN_OWNER_EMAIL, ADMIN_OWNER_PASSWORD_HASH
  //   (or ADMIN_OWNER_INITIAL_PASSWORD)
  "vars": {
    // Public, non-secret build-time-style vars can go here if ever needed.
  },
  "observability": {
    "enabled": true
  }
}
