# ─── Auth ───────────────────────────────────────────────────────────────────
# Sign the admin session JWT. MUST be a strong 32+ char random string in prod.
# Prod (Cloudflare): set via `wrangler secret put JWT_SECRET` — never here.
JWT_SECRET=change-me-to-a-32-byte-random-string

# Admin owner.
#  • Dev: an owner is seeded into data/users.json on first run from these.
#  • Prod (Cloudflare Workers): the owner is the secret-managed identity —
#    `wrangler secret put ADMIN_OWNER_EMAIL` + ADMIN_OWNER_PASSWORD_HASH.
ADMIN_OWNER_EMAIL=owner@dancehyderabad.com
# Preferred for prod: a PBKDF2 hash (bcrypt $2… works in dev only — too much
# CPU for the Workers free plan). Generate: npm run hash-password -- '<pw>'
# ⚠ The hash contains `$` characters and dotenv EXPANDS $VAR references —
# pasting it here silently corrupts it (login then always 401s). In THIS file
# escape each `$` as `\$`, or better: in dev just use the plaintext var
# below, and keep the hash only in `wrangler secret put` (no dotenv, safe).
ADMIN_OWNER_PASSWORD_HASH=
# …or a plaintext password (compared timing-safely; fine to start with).
ADMIN_OWNER_INITIAL_PASSWORD=change-me

# ─── Storage ────────────────────────────────────────────────────────────────
# Nothing to configure in dev → content/versions/uploads use the local
# filesystem (data/, public/uploads/). In prod the CONTENT_BUCKET R2 binding
# in wrangler.jsonc is the store — there is no storage env var anymore.

# ─── Optional ───────────────────────────────────────────────────────────────
# GA4 measurement id (G-XXXXXXX). Build-time inlined — set it in the deploy
# workflow env, not as a wrangler secret.
NEXT_PUBLIC_GA4_ID=
